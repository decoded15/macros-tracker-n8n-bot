      "parameters": {
        "jsonSchemaExample": "{\n  \"foods\": [\n    {\n      \"food\": \"eggs\",\n      \"quantity\": \"2\",\n      \"calories\": 144,\n      \"protein\": 12.6,\n      \"carbs\": 0.8,\n      \"fat\": 9.6\n    },\n    {\n      \"food\": \"paneer\",\n      \"quantity\": \"100g\",\n      \"calories\": 265,\n      \"protein\": 18,\n      \"carbs\": 6,\n      \"fat\": 20\n    }\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
