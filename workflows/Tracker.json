        "text": "=🍽️ Your Meal\n\n{{ $json.foods.map(f => `🍴 ${f.food} — ${f.quantity} 🔥 ${f.calories} kcal | 💪 ${f.protein}g protein | 🍞 ${f.carbs}g carbs | 🥑 ${f.fat}g fat`).join('\\n\\n') }}\n\n━━━━━━━━━━━━━━\n\n📊 Total Nutrition\n🔥 Calories: {{ $json.total_calories }} kcal\n💪 Protein: {{ $json.total_protein }} g\n🍞 Carbs: {{ $json.total_carbs }} g\n🥑 Fat: {{ $json.total_fat }} g",
