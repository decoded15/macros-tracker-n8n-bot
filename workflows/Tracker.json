    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI nutritionist.\nAnalyze the user's food description and estimate the nutritional values of every food item mentioned.\nFor each food:\n- Identify the food\n- Identify the quantity/serving size\n- Estimate calories\n- Estimate protein in grams\n- Estimate carbohydrates in grams\n- Estimate fat in grams\nUse reasonable average nutritional values. Exact accuracy is not required.\nThe user may mention Indian foods, homemade dishes, curries, snacks, beverages, etc. Use your best reasonable estimate for such foods.\nUser's food description: {{ $json.message }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
