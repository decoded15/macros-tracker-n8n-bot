    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst total_calories = rows.reduce(\n  (sum, item) => sum + Number(item.json.calories || 0),\n  0\n);\n\nconst total_protein = rows.reduce(\n  (sum, item) => sum + Number(item.json.protein || 0),\n  0\n);\n\nconst total_carbs = rows.reduce(\n  (sum, item) => sum + Number(item.json.carbs || 0),\n  0\n);\n\nconst total_fat = rows.reduce(\n  (sum, item) => sum + Number(item.json.fat || 0),\n  0\n);\n\nreturn [\n  {\n    json: {\n      chat_id: rows[0]?.json.chat_id,\n      date: rows[0]?.json.date,\n      foods: rows.map(item => ({\n        food: item.json.food,\n        quantity: item.json.quantity,\n        calories: Number(item.json.calories || 0),\n        protein: Number(item.json.protein || 0),\n        carbs: Number(item.json.carbs || 0),\n        fat: Number(item.json.fat || 0)\n      })),\n      total_calories,\n      total_protein,\n      total_carbs,\n      total_fat\n    }\n  }\n];"
      },
